
name: Build ImmortalWrt 25.12 for RAX3000M

on:
  workflow_dispatch:
  schedule:
    - cron: '0 0 * * *'

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Get current date
        id: date
        run: echo "date=$(date +'%Y%m%d')" >> $GITHUB_OUTPUT

      - name: Check upstream updates
        id: check
        run: |
          UPSTREAM_COMMIT=$(git ls-remote --heads https://github.com/chasey-dev/immortalwrt-mt798x-rebase.git 25.12 | awk '{print $1}')
          echo "upstream_commit=$UPSTREAM_COMMIT" >> $GITHUB_OUTPUT
          
          if [ -f .last_sync_commit ]; then
            LAST_COMMIT=$(cat .last_sync_commit)
          else
            LAST_COMMIT=""
          fi
          
          if [ "$LAST_COMMIT" = "$UPSTREAM_COMMIT" ] && [ "${{ github.event_name }}" != "workflow_dispatch" ]; then
            echo "need_build=false" >> $GITHUB_OUTPUT
          else
            echo "need_build=true" >> $GITHUB_OUTPUT
          fi

      - name: Skip if no update
        if: steps.check.outputs.need_build == 'false'
        run: |
          echo "上游无更新，跳过编译"
          exit 0

      - name: Build firmware
        if: steps.check.outputs.need_build == 'true'
        run: |
          git clone https://github.com/chasey-dev/immortalwrt-mt798x-rebase.git openwrt -b 25.12
          cd openwrt
          
          ./scripts/feeds update -a
          ./scripts/feeds install -a
          
          # 这里用你自己仓库里的配置文件（标准原生写法）
          curl -L -o .config https://raw.githubusercontent.com/tfnhui/immortalwrt-mt798x-25.12/main/defconfig/rax3000m.config
          
          make download -j$(nproc)
          make -j$(nproc)
          
          rm -rf bin/targets/mediatek/filogic/packages

      - name: Update sync record
        if: steps.check.outputs.need_build == 'true'
        run: |
          echo "${{ steps.check.outputs.upstream_commit }}" > .last_sync_commit
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add .last_sync_commit
          git commit -m "Update sync record" || true
          git push || true

      - name: Upload firmware
        if: steps.check.outputs.need_build == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: immortalwrt-25.12-rax3000m-firmware
          path: openwrt/bin/targets/mediatek/filogic/

      - name: Create Release
        if: steps.check.outputs.need_build == 'true'
        uses: softprops/action-gh-release@v1
        with:
          name: "RAX3000M 固件 ${{ steps.date.outputs.date }} #${{ github.run_number }}"
          tag_name: "build-${{ steps.date.outputs.date }}-${{ github.run_number }}"
          body: |
            自动同步上游编译
            设备：RAX3000M
            内核：6.12
          files: openwrt/bin/targets/mediatek/filogic/*
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
